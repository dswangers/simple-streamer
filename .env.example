# TMDB API credentials — get one at https://www.themoviedb.org/settings/api
# Accepts either a v3 API key or a v4 read access token.
TMDB_API_KEY=

# OMDb API key (IMDb/Rotten Tomatoes/Metacritic ratings) — free key at
# https://www.omdbapi.com/apikey.aspx. Optional: ratings just don't show up
# without it.
OMDB_API_KEY=

# Postgres connection string used to store Continue Watching / Favorites.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simple_streamer

# Port the combined app + API server listens on.
PORT=4173

# HTTP Basic Auth. Leave BOTH blank on a private network (LAN, or the
# Tailscale setup in dedicated-server/) — nothing prompts for a password
# then. Set BOTH when the server is reachable from the public internet
# (see render/): without them, anyone with the URL can read and modify your
# watch history and spend your TMDB/OMDb quota.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
